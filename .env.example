# CRA only inlines vars prefixed REACT_APP_ at build time — copy this to
# .env (gitignored) and fill in real values before running locally.

# Base URL of the ipfs-data-server backend this frontend talks to.
# Every API call in src/services/api.js (and elsewhere) is built from this —
# leaving it unset makes API calls resolve against this frontend's own
# domain instead, which fails silently in any deployed environment.
REACT_APP_API_BASE_URL=http://localhost:4000

# PayPal client ID used by UpgradeModal.js to load PayPal's Buttons SDK for
# paid-plan checkout. This is a public, client-side value (not a secret) —
# get it from a PayPal Developer app at developer.paypal.com. Use a sandbox
# app's client ID for local development.
REACT_APP_PAYPAL_CLIENT_ID=
